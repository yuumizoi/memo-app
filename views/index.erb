<%# frozen_string_literal: true %>

<h2 class="h4 mb-3">メモ一覧</h2>
<% if @memos.empty? %>
  <p>メモはまだありません。</p>
<% else %>
  <ul class="list-unstyled mb-3">
    <% @memos.each do |memo| %>
      <li class="border-bottom py-2">
        <a href="/memos/<%= memo.id %>">
          <%= h(memo.title) %>
        </a>
      </li>
    <% end %>
  </ul>
<% end %>
<div class="mt-3">
  <a href="/memos/new" class="btn btn-secondary">メモを追加する</a>
</div>

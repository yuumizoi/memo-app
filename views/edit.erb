<h2 class="h4 mb-3">メモを編集</h2>

<form method="POST" action="/memos/<%= @memo_id %>">
  <div class="mb-3">
    <label for="title" class="form-label">タイトル：</label>
    <input type="text" id="title" name="title" value="<%= @memo['title'] %>" class="form-control" autocomplete="off">
  </div>
  <div class="mb-3">
    <label for="content" class="form-label">内容：</label>
    <textarea id="content" name="content" rows="5" class="form-control"><%= @memo['content'] %></textarea>
  </div>

  <input type="hidden" name="_method" value="patch">

  <div>
    <input type="submit" value="更新する" class="btn btn-secondary">
  </div>
</form>
<hr class="my-4">
<p>
  <a href="/memos" class="btn btn-outline-secondary">一覧に戻る</a>
</p>
